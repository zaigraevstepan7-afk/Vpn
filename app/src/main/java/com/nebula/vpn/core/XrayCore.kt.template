package com.nebula.vpn.core

import android.net.VpnService
import android.os.ParcelFileDescriptor
import android.util.Log
import libv2ray.Libv2ray
import libv2ray.V2RayPoint
import libv2ray.V2RayVPNServiceSupportsSet

class XrayCore : V2RayCore {

    override val isAvailable: Boolean = true

    private var point: V2RayPoint? = null
    private var tun2socks: Process? = null
    private var tunFd: ParcelFileDescriptor? = null

    override fun start(
        service: VpnService,
        tun: ParcelFileDescriptor,
        configJson: String,
        onStatus: (String) -> Unit
    ) {
        tunFd = tun

        val support = object : V2RayVPNServiceSupportsSet {
            // Protect the core's own sockets from the VPN route.
            override fun protect(fd: Long): Boolean = service.protect(fd.toInt())

            // Start tun2socks bridging the tun fd to the local SOCKS inbound.
            override fun setup(s: String): Long {
                startTun2Socks(service, tun)
                return 0
            }

            override fun shutdown(): Long { stopTun2Socks(); return 0 }
            override fun onEmitStatus(code: Long, msg: String): Long {
                onStatus(msg); return 0
            }
            override fun prepare(): Long = 0
            override fun sendFd(): Long = 0   // fd handed to tun2socks directly below
        }

        val p = Libv2ray.newV2RayPoint(support, false)
        p.configureFileContent = configJson
        p.domainName = "" // optional: "host:port" of the outbound for faster first connect
        point = p
        p.runLoop(false)
        onStatus("Connected")
        Log.i(TAG, "Xray core running")
    }

    override fun stop() {
        runCatching { point?.stopLoop() }
        point = null
        stopTun2Socks()
        runCatching { tunFd?.close() }
        tunFd = null
    }

    // ── tun2socks ────────────────────────────────────────────────────────────
    // Replace this with the bridge that matches the library you bundle.
    // Below is the badvpn-style invocation that forwards the tun fd to
    // 127.0.0.1:<SOCKS_PORT>. With hev-socks5-tunnel you would instead call its
    // JNI entry point with a small YAML/JSON config.
    private fun startTun2Socks(service: VpnService, tun: ParcelFileDescriptor) {
        // Example skeleton only — see the chosen tun2socks library's docs.
        Log.i(TAG, "TODO: start tun2socks for fd=${tun.fd} -> 127.0.0.1:" +
            com.nebula.vpn.proxy.XrayConfigBuilder.SOCKS_PORT)
    }

    private fun stopTun2Socks() {
        runCatching { tun2socks?.destroy() }
        tun2socks = null
    }

    private companion object { const val TAG = "XrayCore" }
}
